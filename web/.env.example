# Supabase project (Settings > API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Settings > API Keys > Secret keys). Needed to create staff logins
# and reset passwords. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=

# Optional demo logins pre-filled on /login. Anyone who can open /login sees them,
# including on a deployed site. Leave empty (or remove) to turn this off.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CHEF_EMAIL=
DEMO_CHEF_PASSWORD=
