# Supabase project (Settings > API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Settings > API Keys > Secret keys). Needed to create staff logins
# and reset passwords. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=
